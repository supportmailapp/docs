---
import crypto from "node:crypto";

const id = `moon-mask-${crypto.randomBytes(4).toString("hex")}`;

// https://web.dev/building-a-theme-switch-component/
// https://github.com/withastro/starlight/blob/9237581c766f68fbb3ce5f9401ca2046f106c7d5/packages/starlight/components/ThemeSelect.astro
---

<sm-theme-select>
  <button
    aria-label={Astro.locals.t("themeSelect.accessibleLabel")}
    aria-live="polite"
    class="sl-flex"
    title={Astro.locals.t("themeSelect.accessibleLabel")}
  >
    <svg aria-hidden="true" height="16" viewBox="0 0 24 24" width="16">
      <mask class="moon" id={id}>
        <rect x="0" y="0" width="100%" height="100%" fill="white"></rect>
        <circle cx="24" cy="10" r="6" fill="black"></circle>
      </mask>
      <circle class="sun" cx="12" cy="12" r="6" mask={`url(#${id})`}></circle>
      <g class="sun-beams" stroke="currentColor">
        <line x1="12" y1="1" x2="12" y2="3"></line>
        <line x1="12" y1="21" x2="12" y2="23"></line>
        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
        <line x1="1" y1="12" x2="3" y2="12"></line>
        <line x1="21" y1="12" x2="23" y2="12"></line>
        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
        <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
      </g>
    </svg>
    <span class="auto-badge" aria-hidden="true">A</span>
  </button>
</sm-theme-select>

<style>
  @layer components {
    sm-theme-select {
      --sm-theme-select-animation-duration: 400ms;
      --sm-theme-select-ease-elastic: cubic-bezier(
        0.5,
        1.25,
        0.75,
        1.25
      );

      align-self: stretch;
    }

    button {
      align-items: center;
      background-color: transparent;
      border: none;
      cursor: pointer;
      height: 100%;
      margin-inline: 0.5rem 0.5rem;
      padding-inline: 0.75rem;
    }

    svg {
      stroke-linecap: round;
    }

    svg :is(.moon, .sun, .sun-beams) {
      transform-origin: center;
    }

    svg :is(.moon, .sun) {
      fill: var(--sl-color-gray-2);
    }

    svg .sun-beams {
      stroke: var(--sl-color-gray-2);
      stroke-width: 2px;
    }

    button:is(:hover, :focus-visible) svg :is(.moon, .sun) {
      fill: var(--sl-color-accent-high);
    }

    button:is(:hover, :focus-visible) svg .sun-beams {
      stroke: var(--sl-color-accent-high);
    }

    :global([data-theme="dark"]) svg .sun {
      transform: scale(1.75);
    }

    :global([data-theme="dark"]) svg .sun-beams {
      opacity: 0;
    }

    :global([data-theme="dark"]) svg .moon circle {
      transform: translateX(-7px);
    }

    @supports (cx: 1) {
      :global([data-theme="dark"]) svg .moon circle {
        cx: 17;
        transform: translateX(0);
      }
    }

    @keyframes theme-icon-spin {
      from {
        transform: rotate(0deg);
      }
      to {
        transform: rotate(360deg);
      }
    }

    :global([data-theme="dark"]) svg {
      animation: theme-icon-spin
        var(--sm-theme-select-animation-duration) ease;
    }

    :global([data-theme="light"]) svg {
      animation: theme-icon-spin
        var(--sm-theme-select-animation-duration) ease reverse;
    }

    svg .sun {
      transition: transform var(--sm-theme-select-animation-duration)
        var(--sm-theme-select-ease-elastic);
    }

    svg .sun-beams {
      transition:
        opacity var(--sm-theme-select-animation-duration) ease,
        transform var(--sm-theme-select-animation-duration)
          var(--sm-theme-select-ease-elastic);
    }

    svg .moon circle {
      transition: transform
        calc(var(--sm-theme-select-animation-duration) / 2) ease-out;
    }

    @supports (cx: 1) {
      svg .moon circle {
        transition: cx
          calc(var(--sm-theme-select-animation-duration) / 2) ease-out;
      }
    }

    :global([data-theme="dark"]) svg .sun {
      transform: scale(1.75);
      transition-duration: calc(
        var(--sm-theme-select-animation-duration) / 2
      );
      transition-timing-function: ease;
    }

    :global([data-theme="dark"]) svg .sun-beams {
      transform: rotateZ(-25deg);
      transition-duration: calc(
        var(--sm-theme-select-animation-duration) / 4
      );
    }

    :global([data-theme="dark"]) svg .moon circle {
      transition-delay: calc(
        var(--sm-theme-select-animation-duration) / 4
      );
      transition-duration: var(--sm-theme-select-animation-duration);
    }

    button {
      position: relative;
    }

    /* Small "A" in the top corner marks auto mode (follows the system setting). */
    .auto-badge {
      position: absolute;
      inset-block-start: 0.1rem;
      inset-inline-end: 0.1rem;
      display: none;
      width: 0.8rem;
      height: 0.8rem;
      border-radius: 999px;
      background: var(--sm-blue-strong);
      color: var(--sm-on-blue);
      font: 700 0.5rem/0.8rem var(--sm-font-body);
      text-align: center;
      pointer-events: none;
    }

    :global(sm-theme-select[data-mode="auto"]) .auto-badge {
      display: block;
    }
  }
</style>

{/* Inlined to avoid FOUC. Uses global scope from `ThemeProvider.astro` */}
<script is:inline>
  StarlightThemeProvider.updatePickers();
</script>

<script>
  /** Picker mode. Stored as Starlight does: "light", "dark", or "" for auto. */
  type Mode = "auto" | "dark" | "light";

  const storageKey = "starlight-theme";
  const order: Mode[] = ["dark", "light", "auto"];
  const labels: Record<Mode, string> = {
    dark: "Dark theme (click for light)",
    light: "Light theme (click to follow system)",
    auto: "System theme (click for dark)",
  };

  function loadMode(): Mode {
    const stored =
      typeof localStorage !== "undefined" ? localStorage.getItem(storageKey) : null;
    return StarlightThemeProvider.modeOf(stored) as Mode;
  }

  function apply(mode: Mode, store: boolean): void {
    StarlightThemeProvider.updatePickers(mode);
    document.documentElement.dataset["theme"] =
      mode === "auto" ? StarlightThemeProvider.systemTheme() : mode;
    if (store && typeof localStorage !== "undefined") {
      localStorage.setItem(storageKey, mode === "auto" ? "" : mode);
    }
    document.querySelectorAll("sm-theme-select button").forEach((b) => {
      b.setAttribute("aria-label", labels[mode]);
      b.setAttribute("title", labels[mode]);
    });
  }

  // Follow system changes only while in auto mode.
  matchMedia("(prefers-color-scheme: light)").addEventListener("change", () => {
    if (loadMode() === "auto") apply("auto", false);
  });

  customElements.define(
    "sm-theme-select",
    class SmThemeSelect extends HTMLElement {
      constructor() {
        super();
        // Do not store anything on load, so a first visit stays "nothing stored".
        apply(loadMode(), false);
        this.querySelector("button")?.addEventListener("click", () => {
          const next = order[(order.indexOf(loadMode()) + 1) % order.length];
          apply(next, true);
        });
      }
    }
  );
</script>
