---
// Previous / next as two rounded cards.
import { Icon } from "@astrojs/starlight/components";

const { dir, pagination } = Astro.locals.starlightRoute;
const { prev, next } = pagination;
const isRtl = dir === "rtl";
---

<div class="pagination-links print:hidden" dir={dir}>
  {
    prev && (
      <a href={prev.href} rel="prev">
        <Icon name={isRtl ? "right-arrow" : "left-arrow"} size="1.25rem" />
        <span>
          <span class="hint">{Astro.locals.t("page.previousLink")}</span>
          <span class="link-title">{prev.label}</span>
        </span>
      </a>
    )
  }
  {
    next && (
      <a href={next.href} rel="next">
        <Icon name={isRtl ? "left-arrow" : "right-arrow"} size="1.25rem" />
        <span>
          <span class="hint">{Astro.locals.t("page.nextLink")}</span>
          <span class="link-title">{next.label}</span>
        </span>
      </a>
    )
  }
</div>

<style>
  .pagination-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr));
    gap: 0.75rem;
  }

  a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    border: 1px solid transparent;
    border-radius: var(--sm-radius-lg);
    background-color: var(--sm-surface-2);
    color: var(--sm-text-muted);
    text-decoration: none;
    overflow-wrap: anywhere;
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease;
  }

  a:is(:hover, :focus-visible) {
    background-color: var(--sm-surface-3);
    border-color: var(--sm-line);
  }

  [rel="next"] {
    justify-content: end;
    text-align: end;
    flex-direction: row-reverse;
  }

  .hint {
    display: block;
    font-size: var(--sl-text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .link-title {
    display: block;
    margin-top: 0.15rem;
    color: var(--sm-text-strong);
    font-family: var(--sm-font-display);
    font-size: var(--sl-text-xl);
    line-height: var(--sl-line-height-headings);
  }

  a :global(svg) {
    flex-shrink: 0;
    color: var(--sm-blue-soft);
  }
</style>
