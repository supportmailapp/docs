---
// Console landing hero: copy and actions on the left, the logo on a soft tile
// on the right. Actions come from the page's `hero.actions` frontmatter; an
// "Open dashboard" secondary action is always appended here because its URL
// comes from PUBLIC_DASHBOARD_URL, which frontmatter cannot read.
import { Image } from "astro:assets";
import { PUBLIC_DASHBOARD_URL } from "astro:env/client";
import DraftContentNotice from "virtual:starlight/components/DraftContentNotice";
import LinkButton from "../LinkButton.astro";

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, image, actions = [] } = data.hero || {};
const dashboardUrl = PUBLIC_DASHBOARD_URL ?? "https://dash.supportmail.dev";
const logo = image && "file" in image ? image.file : undefined;
---

<div class="sm-hero">
  <div class="copy">
    <p class="eyebrow">Documentation</p>
    <h1 id="_top" data-page-title set:html={title} />
    {data.draft && <DraftContentNotice />}
    {tagline && <p class="tagline" set:html={tagline} />}
    <div class="actions">
      {
        actions.map(({ link: href, text, variant }) => (
          <LinkButton href={href} variant={variant === "minimal" ? "minimal" : variant === "secondary" ? "secondary" : "primary"} icon="right-arrow">
            {text}
          </LinkButton>
        ))
      }
      <LinkButton href={dashboardUrl} variant="secondary" icon="external">
        Open dashboard
      </LinkButton>
    </div>
  </div>
  {
    logo && (
      <div class="art" aria-hidden="true">
        <Image src={logo} alt="" width={320} height={320} loading="eager" fetchpriority="high" />
      </div>
    )
  }
</div>

<style>
  .sm-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: 2rem;
    padding-block: 2.5rem 1rem;
  }

  @media (min-width: 50rem) {
    .sm-hero {
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
      gap: 3rem;
      padding-block: 4rem 2rem;
    }
  }

  .copy {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-width: 0;
  }

  .eyebrow {
    margin: 0;
    color: var(--sm-blue-soft);
    font-size: var(--sl-text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    color: var(--sm-text-strong);
    font-family: var(--sm-font-display);
    font-size: clamp(2.25rem, 1.5rem + 3.5vw, 3.75rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
    overflow-wrap: anywhere;
  }

  .tagline {
    margin: 0;
    max-width: 34rem;
    color: var(--sm-text-muted);
    font-size: var(--sl-text-xl);
    line-height: 1.5;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .actions :global(.sl-link-button) {
    margin: 0;
  }

  .art {
    display: grid;
    place-items: center;
    justify-self: center;
    width: min(100%, 18rem);
    aspect-ratio: 1;
    border-radius: var(--sm-radius-lg);
    background:
      radial-gradient(circle at 50% 45%, color-mix(in oklab, var(--sm-blue-strong) 35%, transparent), transparent 70%),
      var(--sm-surface-2);
  }

  .art :global(img) {
    width: 55%;
    height: auto;
    border-radius: 22%;
  }

  @media (max-width: 49.99rem) {
    .art {
      display: none;
    }
  }
</style>
