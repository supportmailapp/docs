---
// Dark-first replacement for Starlight's ThemeProvider.
// Storage format is Starlight's own key "starlight-theme": "light" or "dark",
// and "" for auto (follow the system). `localStorage.getItem` returns null when
// nothing was ever stored: that first visit gets dark, whatever
// `prefers-color-scheme` says. A stored "" (auto) follows the system.
// Also sets `data-theme-mode` ("dark" | "light" | "auto") on <html>, which
// ThemeSelect reads to show the right icon before first paint.
---

{/* Inlined to avoid a flash of the wrong theme. */}
<script is:inline>
  (() => {
    let stored = null;
    try {
      stored = localStorage.getItem("starlight-theme");
    } catch {}
    const system = window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
    const theme = stored === null ? "dark" : stored === "" ? system : stored;
    document.documentElement.dataset.theme = theme === "light" ? "light" : "dark";
    document.documentElement.dataset.themeMode =
      stored === null ? "dark" : stored === "" ? "auto" : stored === "light" ? "light" : "dark";
  })();
</script>
