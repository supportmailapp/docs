---
// Page title with the sidebar group name as a small eyebrow above it (CSS ::before).
// The <h1 id="_top"> must stay a direct child of .sl-container:
// starlight-contextual-menu finds it with `.sl-container>h1`.
import type { StarlightRouteData } from "@astrojs/starlight/route-data";

type Entry = StarlightRouteData["sidebar"][number];

const route = Astro.locals.starlightRoute;

/** Label of the top-level group that contains the current page, if any. */
function findGroup(entries: Entry[], top?: string): string | undefined {
  for (const entry of entries) {
    if (entry.type === "link" && entry.isCurrent) return top;
    if (entry.type === "group") {
      const found = findGroup(entry.entries, top ?? entry.label);
      if (found) return found;
    }
  }
  return undefined;
}

const group = findGroup(route.sidebar);
---

<h1 id="_top" data-group={group}>{route.entry.data.title}</h1>

<style>
  /* The eyebrow is generated from data-group, not a sibling element: the
     contextual menu turns .sl-container into a flex row, and a sibling would
     sit beside the title. The h1's own text stays just the title. */
  h1 {
    margin-top: 1rem;
    color: var(--sm-text-strong);
    font-family: var(--sm-font-display);
    font-size: clamp(2rem, 1.4rem + 2.4vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  h1[data-group]::before {
    content: attr(data-group);
    display: block;
    margin-bottom: 0.5rem;
    color: var(--sm-blue-soft);
    font-family: var(--sm-font-body);
    font-size: var(--sl-text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1.4;
    text-transform: uppercase;
  }
</style>
