---
// V2 Media Gallery: 1-10 images in a grid (the bot uses it for report and
// ticket attachments).
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  items: ImageMetadata[];
}

const { items } = Astro.props;
const cols = items.length === 1 ? 1 : items.length === 2 || items.length === 4 ? 2 : 3;
---

<div class="sm-dgallery" style={`--sm-cols: ${cols}`}>
  {items.map((src) => <Image src={src} alt="" width={400} />)}
</div>

<style>
  .sm-dgallery {
    display: grid;
    grid-template-columns: repeat(var(--sm-cols), minmax(0, 1fr));
    gap: 0.25rem;
    max-width: 32rem;
    overflow: hidden;
    border-radius: var(--sm-radius-md);
  }

  .sm-dgallery :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }
</style>
