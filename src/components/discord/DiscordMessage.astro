---
// A drawn Discord message: avatar, name, optional APP badge and timestamp, then
// the slot (text, DiscordEmbed, DiscordButtons). Presentational, no client JS.
// Copy message text from v2/messages/en.json where a key exists, and put a
// {/* en.json: <key> */} comment next to it so drift can be grepped.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import defaultBotAvatar from "../../assets/logo.png";

interface Props {
  author: string;
  bot?: boolean;
  avatar?: ImageMetadata;
  time?: string;
}

const { author, bot = false, avatar, time } = Astro.props;
const avatarSrc = avatar ?? (bot ? defaultBotAvatar : undefined);
const initial = author.trim().charAt(0).toUpperCase();
---

<div class="sm-dmsg not-content" role="figure" aria-label={`Discord message from ${author}`}>
  {
    avatarSrc ? (
      <Image src={avatarSrc} alt="" width={80} height={80} class="avatar" />
    ) : (
      <span class="avatar avatar-fallback" aria-hidden="true">
        {initial}
      </span>
    )
  }
  <div class="body">
    <div class="meta">
      <span class="author">{author}</span>
      {bot && <span class="app-badge">APP</span>}
      {time && <span class="time">{time}</span>}
    </div>
    <div class="content"><slot /></div>
  </div>
</div>

<style>
  .sm-dmsg {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 0 0.85rem;
    margin-block: 1rem;
    padding: 0.85rem 1rem;
    border-radius: var(--sm-radius-lg);
    background-color: var(--sm-surface-2);
    color: var(--sm-text);
    font-family: var(--sm-font-body);
    font-size: var(--sl-text-sm);
    line-height: 1.5;
  }

  .avatar {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    object-fit: cover;
  }

  .avatar-fallback {
    display: grid;
    place-items: center;
    background-color: var(--sm-blue);
    color: var(--sm-on-blue);
    font-weight: 700;
  }

  .body {
    min-width: 0;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem;
  }

  .author {
    color: var(--sm-text-strong);
    font-weight: 600;
  }

  .app-badge {
    align-self: center;
    padding: 0 0.3rem;
    border-radius: 4px;
    background-color: oklch(0.55 0.2 275);
    color: oklch(0.99 0 0);
    font-size: 0.625rem;
    font-weight: 700;
    line-height: 1rem;
  }

  .time {
    color: var(--sm-text-muted);
    font-size: var(--sl-text-xs);
  }

  .content {
    overflow-wrap: anywhere;
  }

  .content > :global(* + *) {
    margin-top: 0.5rem;
  }

  .content :global(p) {
    margin: 0;
  }
</style>
