---
// One Discord button (V2 Button). Presentational: a span, not a real control.
import type { DiscordButton } from "./types";

type Props = DiscordButton;
const { label, style, emoji } = Astro.props;
---

<span class:list={["dbtn", style]}>
  {emoji && <span class="emoji" aria-hidden="true">{emoji}</span>}
  {label}
  {
    style === "link" && (
      <svg class="ext" aria-hidden="true" viewBox="0 0 24 24" width="14" height="14">
        <path
          fill="currentColor"
          d="M14 3h7v7h-2V6.41l-9.29 9.3-1.42-1.42L17.59 5H14V3ZM5 5h6v2H5v12h12v-6h2v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Z"
        />
      </svg>
    )
  }
</span>

<style>
  .dbtn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    min-height: 2rem;
    padding: 0 1rem;
    border-radius: var(--sm-radius-md);
    color: oklch(0.99 0 0);
    font-size: var(--sl-text-sm);
    font-weight: 500;
    line-height: 1;
    white-space: nowrap;
    cursor: default;
  }

  /* Discord's own button colours, readable with white text. */
  .primary {
    background-color: oklch(0.52 0.19 275);
  }

  .secondary,
  .link {
    background-color: oklch(0.42 0.015 270);
  }

  .success {
    background-color: oklch(0.5 0.13 150);
  }

  .danger {
    background-color: oklch(0.52 0.19 25);
  }

  .ext {
    opacity: 0.85;
  }
</style>
